#!/usr/bin/env bash
#
# script/install/memvid
#
# Install memvid - Portable single-file memory system for AI agents
# https://github.com/memvid/memvid
#
# Uses uv for Python package management (no system pip)

set -e

cd "$(dirname "$0")/../.."
REPO_ROOT="$(pwd)"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info() { echo -e "${GREEN}==>${NC} $1"; }
log_warn() { echo -e "${YELLOW}==>${NC} $1"; }
log_error() { echo -e "${RED}==>${NC} $1"; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

# Ensure uv is available
ensure_uv() {
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
    if ! command_exists uv; then
        log_info "Installing uv first..."
        "$REPO_ROOT/script/install/uv" || return 1
        export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
    fi
}

# Ensure .venv exists
ensure_venv() {
    if [ ! -d "$REPO_ROOT/.venv" ]; then
        log_info "Creating .venv..."
        uv venv "$REPO_ROOT/.venv"
    fi
}

install_memvid() {
    log_info "Installing memvid..."

    local installed=false

    # Install CLI via npm
    if command_exists npm; then
        if command_exists memvid; then
            log_info "memvid CLI already installed"
        else
            log_info "Installing memvid-cli via npm..."
            npm install -g memvid-cli 2>/dev/null && installed=true || log_warn "memvid-cli npm install failed"
        fi
    else
        log_warn "npm not found, skipping CLI install"
    fi

    # Install Python SDK using uv
    if ensure_uv; then
        ensure_venv
        log_info "Installing memvid-sdk via uv..."
        cd "$REPO_ROOT"
        uv pip install --quiet --upgrade memvid-sdk 2>/dev/null && installed=true || log_warn "memvid-sdk install failed"
    else
        log_warn "uv not available, skipping Python SDK install"
    fi

    # Install Rust crate if cargo available
    if command_exists cargo; then
        log_info "Note: For Rust integration, add to Cargo.toml:"
        log_info "  memvid-core = \"2.0\""
    fi

    if [ "$installed" = true ]; then
        log_info "memvid installed successfully"
    else
        log_error "Could not install memvid - npm or uv required"
        exit 1
    fi
}

install_memvid "$@"
