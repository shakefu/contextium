#!/usr/bin/env bash
#
# script/install/uv
#
# Install uv - Fast Python package manager from Astral
# https://github.com/astral-sh/uv
#
# uv is used instead of pip to avoid system Python issues and sudo prompts.
# It automatically creates and manages a local .venv for the project.

set -e

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info() { echo -e "${GREEN}==>${NC} $1"; }
log_warn() { echo -e "${YELLOW}==>${NC} $1"; }
log_error() { echo -e "${RED}==>${NC} $1"; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

install_uv() {
    if command_exists uv; then
        log_info "uv already installed: $(uv --version)"
        return 0
    fi

    log_info "Installing uv..."

    # Try the official installer (works on macOS, Linux, Windows via WSL)
    if curl -LsSf https://astral.sh/uv/install.sh | sh 2>/dev/null; then
        # Source the shell config to get uv in PATH
        export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
        if command_exists uv; then
            log_info "uv installed successfully: $(uv --version)"
            return 0
        fi
    fi

    # Fallback: try Homebrew on macOS
    if command_exists brew; then
        log_info "Trying Homebrew..."
        if brew install uv 2>/dev/null; then
            log_info "uv installed via Homebrew: $(uv --version)"
            return 0
        fi
    fi

    # Fallback: try pipx (if available)
    if command_exists pipx; then
        log_info "Trying pipx..."
        if pipx install uv 2>/dev/null; then
            log_info "uv installed via pipx: $(uv --version)"
            return 0
        fi
    fi

    log_error "Could not install uv"
    log_info "Manual install: curl -LsSf https://astral.sh/uv/install.sh | sh"
    return 1
}

install_uv "$@"
