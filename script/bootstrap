#!/usr/bin/env bash
#
# script/bootstrap
#
# Resolve all dependencies that the project requires to run.
# This script builds ctxium and runs its bootstrap module.

set -e

cd "$(dirname "$0")/.."

# Build and install ctxium (which handles all bootstrapping)
./script/install/ctxium

# Run the bootstrap via ctxium hook
echo '{}' | ctxium hook SessionStart
