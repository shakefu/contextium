#!/usr/bin/env bash
#
# script/bootstrap
#
# Resolve all dependencies that the project requires to run.
# This script is idempotent and can be run multiple times safely.
#
# Uses 'uv' for Python package management to avoid system pip issues
# and sudo prompts. All Python packages are installed into a local .venv.

set -e

cd "$(dirname "$0")/.."
REPO_ROOT="$(pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}==>${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}==>${NC} $1"
}

log_error() {
    echo -e "${RED}==>${NC} $1"
}

# Detect OS
detect_os() {
    case "$(uname -s)" in
        Linux*)     echo "linux";;
        Darwin*)    echo "macos";;
        MINGW*|MSYS*|CYGWIN*) echo "windows";;
        *)          echo "unknown";;
    esac
}

OS=$(detect_os)
log_info "Detected OS: $OS"

# Check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Ensure uv is installed (MUST run first, synchronously)
ensure_uv() {
    # Add common uv install locations to PATH
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

    if command_exists uv; then
        log_info "uv available: $(uv --version)"
        return 0
    fi

    log_info "Installing uv (fast Python package manager)..."

    # Try the official installer
    if curl -LsSf https://astral.sh/uv/install.sh | sh 2>/dev/null; then
        export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
        if command_exists uv; then
            log_info "uv installed: $(uv --version)"
            return 0
        fi
    fi

    # Fallback: Homebrew on macOS
    if command_exists brew; then
        if brew install uv 2>/dev/null; then
            log_info "uv installed via Homebrew"
            return 0
        fi
    fi

    log_error "Could not install uv - Python packages will be skipped"
    return 1
}

# Setup Python virtual environment with uv
setup_venv() {
    if ! command_exists uv; then
        log_warn "uv not available, skipping Python setup"
        return 1
    fi

    log_info "Setting up Python virtual environment..."

    # Create .venv if it doesn't exist
    if [ ! -d "$REPO_ROOT/.venv" ]; then
        uv venv "$REPO_ROOT/.venv"
        log_info "Created .venv"
    else
        log_info ".venv already exists"
    fi

    return 0
}

# Install Python packages using uv (into local .venv)
install_python_packages() {
    if ! command_exists uv; then
        return 1
    fi

    log_info "Installing Python packages into .venv..."

    # Install packages using uv pip (automatically uses .venv)
    cd "$REPO_ROOT"

    # litellm - for adversarial-spec multi-model support
    uv pip install --quiet litellm 2>/dev/null || log_warn "litellm install failed"

    # sqlalchemy - for autocoder
    uv pip install --quiet sqlalchemy 2>/dev/null || log_warn "sqlalchemy install failed"

    log_info "Python packages installed"
}

# Install worktrunk - Git worktree management
install_worktrunk() {
    log_info "Installing worktrunk..."

    if command_exists wt; then
        log_info "worktrunk already installed"
        return 0
    fi

    case "$OS" in
        macos)
            if command_exists brew; then
                brew install worktrunk && wt config shell install || log_warn "worktrunk install failed"
            else
                log_warn "Homebrew not found, skipping worktrunk"
            fi
            ;;
        linux)
            if command_exists brew; then
                brew install worktrunk && wt config shell install || log_warn "worktrunk install failed"
            elif command_exists cargo; then
                cargo install worktrunk && wt config shell install || log_warn "worktrunk cargo install failed"
            else
                log_warn "Neither Homebrew nor Cargo found, skipping worktrunk"
            fi
            ;;
        windows)
            if command_exists winget; then
                winget install max-sixty.worktrunk || log_warn "worktrunk winget install failed"
            else
                log_warn "winget not found, skipping worktrunk"
            fi
            ;;
    esac
}

# Install memvid - Portable memory system (npm CLI only, Python via uv)
install_memvid() {
    log_info "Installing memvid..."

    # Install CLI via npm
    if command_exists npm; then
        if ! command_exists memvid; then
            npm install -g memvid-cli 2>/dev/null || log_warn "memvid-cli npm install failed"
        else
            log_info "memvid CLI already installed"
        fi
    fi

    # Python SDK installed via install_python_packages if needed
}

# Install gibram - In-memory knowledge graph
install_gibram() {
    # Use our custom installer that downloads to ~/.local/bin (no sudo)
    "$REPO_ROOT/script/install/gibram" || log_warn "gibram install failed (optional)"
}

# Main installation
main() {
    log_info "Bootstrapping Contextium dependencies..."
    echo ""

    # CRITICAL: Install uv first (synchronously) - needed for Python packages
    ensure_uv

    # Setup venv (synchronously) - needed before Python installs
    setup_venv

    # Install Python packages (synchronously) - uses the venv we just created
    install_python_packages

    # Install other tools in parallel (no pip usage)
    install_worktrunk &
    install_memvid &
    install_gibram &

    # Wait for parallel jobs
    wait

    echo ""
    log_info "Bootstrap complete!"
    log_info "Python packages installed in: $REPO_ROOT/.venv"
    log_info "Activate with: source .venv/bin/activate"
}

main "$@"
