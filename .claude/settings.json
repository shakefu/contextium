{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "nohup ./script/bootstrap > /tmp/contextium-bootstrap.log 2>&1 &"
          },
          {
            "type": "command",
            "command": "./agents/run-startup.sh 2>&1 | tee /tmp/contextium-startup.log"
          }
        ]
      }
    ]
  }
}
